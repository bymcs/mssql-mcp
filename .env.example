# Copy this file to .env and fill in your test database credentials.
# All values here are read by src/config.ts (loadConfigFromEnv / loadHttpConfig).

# --- Database connection (see src/config.ts) ---

# Required: SQL Server hostname or IP address
DB_SERVER=localhost

# Optional: database name to connect to
DB_DATABASE=

# Optional: SQL Server login username
DB_USER=

# Optional: SQL Server login password
DB_PASSWORD=

# Optional: TCP port (default: 1433)
DB_PORT=1433

# Optional: enable TLS encryption (default: true; required for Azure SQL)
DB_ENCRYPT=true

# Optional: trust self-signed certificates, e.g. for local dev (default: false)
DB_TRUST_SERVER_CERTIFICATE=false

# Optional: connection timeout in milliseconds (default: 30000)
DB_CONNECTION_TIMEOUT=30000

# Optional: query/request timeout in milliseconds (default: 30000)
DB_REQUEST_TIMEOUT=30000

# --- Transport (see src/transports/) ---

# Optional: "stdio" (default) or "http"
MCP_TRANSPORT=stdio

# Optional: HTTP bind address, only used when MCP_TRANSPORT=http (default: 127.0.0.1)
MCP_HOST=127.0.0.1

# Optional: HTTP port, only used when MCP_TRANSPORT=http (default: 3001)
MCP_PORT=3001
